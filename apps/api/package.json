{
  "name": "@tigerpingpong/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @tigerpingpong/shared build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @tigerpingpong/shared build",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm --filter @tigerpingpong/shared build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@tigerpingpong/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0"
  }
}
