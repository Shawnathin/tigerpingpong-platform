FROM node:24.16.0-bookworm-slim@sha256:2c87ef9bd3c6a3bd4b472b4bec2ce9d16354b0c574f736c476489d09f560a203
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && rm -rf /var/lib/apt/lists/*
RUN npm install --global pnpm@9.12.0
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV TIGER_PREVIEW_MODE=true
ENV TIGER_PREVIEW_BIND_HOST=0.0.0.0
RUN pnpm --filter @tigerpingpong/shared build && pnpm --filter @tigerpingpong/db build && pnpm --filter @tigerpingpong/api build
USER node
CMD ["node", "scripts/railway/start-preview-api.mjs"]
