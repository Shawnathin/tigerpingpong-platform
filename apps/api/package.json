{
  "name": "@tigerpingpong/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "predev": "pnpm --filter @tigerpingpong/shared build && pnpm --filter @tigerpingpong/db build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @tigerpingpong/shared build && pnpm --filter @tigerpingpong/db build",
    "build": "nest build",
    "start": "node dist/main.js",
    "pretypecheck": "pnpm --filter @tigerpingpong/shared build && pnpm --filter @tigerpingpong/db build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings=0"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@tigerpingpong/db": "workspace:*",
    "@tigerpingpong/shared": "workspace:*",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "stripe": "^22.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24"
  }
}
