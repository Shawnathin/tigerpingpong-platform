{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "deploy/railway/Dockerfile.api" },
  "deploy": {
    "numReplicas": 1,
    "sleepApplication": false,
    "preDeployCommand": "node scripts/railway/prepare-preview-db.mjs",
    "startCommand": "node scripts/railway/start-preview-api.mjs",
    "healthcheckPath": "/catalog/health",
    "healthcheckTimeout": 120,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
